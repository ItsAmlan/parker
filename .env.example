# =========================================================
# Parker — Environment Configuration
# =========================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Parker has NO built-in values for settings that belong to your server (hostnames, paths):
# anything it needs for a run must be set here, or it stops and tells you which one.
# Values still containing "yourdomain.com" or starting with "your_" are treated as not set.
#
# Format: KEY=value. Full-line and trailing "  # comments" are ignored;
# wrap a value in quotes if it must contain " #".

# --- Cloudflare / DNS ---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# Hostname that new sites' DNS records (CNAME) point to: THIS server's public hostname.
# Required for DNS (skip DNS with --no-dns). Only CNAMEs pointing here are ever removed by --remove-dns.
CNAME_TARGET=server.yourdomain.com

# --- SSL ---
DEFAULT_SSL_EMAIL=ssl@yourdomain.com

# --- Mail (Postfix / OpenDKIM / Dovecot) ---
# Required only if you set up mail authentication (SPF/DKIM/DMARC/MX).
MAIL_HOSTNAME=mail.yourdomain.com
DKIM_SELECTOR=default
MX_HOSTNAME=mail.yourdomain.com    # optional: MX record target; defaults to MAIL_HOSTNAME when missing or empty

# --- Paths ---
# Required: base directory for project directories (one subdirectory per domain).
WEBROOT=/var/www
PHP_FPM_SNIPPET=snippets/php8.5.conf    # optional (default: snippets/php8.5.conf)

# --- Project directories (Optional) ---
# Owner of newly created project directories, e.g. your deploy user.
# PROJECT_OWNER=deploy:deploy

# --- Nginx defaults (Optional) ---
# NGINX_SECURITY_HEADERS=1    # 0 disables X-Content-Type-Options / X-Frame-Options / Referrer-Policy
# NGINX_IPV6=auto             # auto | 1 | 0 — add "listen [::]:80" (auto: only if the host supports IPv6)

# --- Audit log (Optional) ---
# PARKER_LOG_FILE=/var/log/parker.log    # every run is appended here (mode 600); empty disables

# --- Dashboard (Optional) ---
# Extra origins allowed to open the terminal WebSocket, comma separated. Only needed if your
# tunnel/proxy rewrites the Host header, so the page's origin no longer matches it.
# PARKER_ALLOWED_ORIGINS=https://parker.yourdomain.com
