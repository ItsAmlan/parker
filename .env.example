# =========================================================
# Parker — Environment Configuration
# =========================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Format: KEY=value. Full-line and trailing "  # comments" are ignored;
# wrap a value in quotes if it must contain " #".

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# --- SSL ---
DEFAULT_SSL_EMAIL=ssl@yourdomain.com

# --- Mail (Postfix / OpenDKIM / Dovecot) ---
MAIL_HOSTNAME=mail.yourdomain.com
DKIM_SELECTOR=default
MX_HOSTNAME=mail.yourdomain.com    # MX record target for incoming mail (defaults to MAIL_HOSTNAME if omitted)

# --- Paths (Optional — sensible defaults are used if omitted) ---
WEBROOT=/var/www
PHP_FPM_SNIPPET=snippets/php8.5.conf

# --- Project directories (Optional) ---
# Owner of newly created project directories, e.g. your deploy user.
# PROJECT_OWNER=deploy:deploy

# --- Nginx defaults (Optional) ---
# NGINX_SECURITY_HEADERS=1    # 0 disables X-Content-Type-Options / X-Frame-Options / Referrer-Policy
# NGINX_IPV6=auto             # auto | 1 | 0 — add "listen [::]:80" (auto: only if the host supports IPv6)

# --- Audit log (Optional) ---
# PARKER_LOG_FILE=/var/log/parker.log    # every run is appended here (mode 600); empty disables

# --- Dashboard (Optional) ---
# Extra origins allowed to open the terminal WebSocket, comma separated. Only needed if your
# tunnel/proxy rewrites the Host header, so the page's origin no longer matches it.
# PARKER_ALLOWED_ORIGINS=https://parker.yourdomain.com
